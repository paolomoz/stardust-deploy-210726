   "items": [
    {
     "role": "heading",
     "order": 0,
     "text": "HOUSING-FOCUSED RESOURCES"
    },
    {
     "role": "body",
     "order": 1,
     "text": "The Road Home team works with individuals and families, each step of the way to help them overcome their homelessness and move back into a home of their own."
    },
    {
     "role": "heading",
     "order": 2,
     "text": "EMERGENCY SHELTER"
    },
    {
     "role": "heading",
     "order": 3,
     "text": "SUPPORTIVE SERVICES"
    },
    {
     "role": "heading",
     "order": 4,
     "text": "HOUSING ASSISTANCE"
    },
    {
     "role": "body",
     "order": 5,
     "text": "Everything we do at The Road Home is to help people overcome homelessness and move back home. This includes nationally recognized best practices such as progressive engagement, rapid re-housing, and housing navigation."
    },
    {
     "role": "cta",
     "order": 6,
     "text": "PROGRAMS",
     "href": "http://theroadhome.org/housing-programs/"
    }
