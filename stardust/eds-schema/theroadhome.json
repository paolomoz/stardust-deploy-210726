    },
    {
     "role": "body",
     "order": 1,
     "text": "The Road Home’s Four Star Charity Navigator assures you of the responsible way in which your contributions will be put to work helping the people we serve."
    },
    {
     "role": "body",
     "order": 2,
     "text": "1,550+"
    },
    {
     "role": "body",
     "order": 3,
     "text": "On any given night, we have over 1,550 people in housing, in the community"
    },
    {
     "role": "body",
     "order": 4,
     "text": "60%"
    },
    {
     "role": "body",
     "order": 5,
     "text": "Of those who shelter with us, 60% receive case management services at some point during their stay"
    },
    {
     "role": "body",
     "order": 6,
     "text": "3,491"
    },
    {
     "role": "body",
     "order": 7,
     "text": "In the last year we assisted 3,491 people with employment and housing-related services"
    }
